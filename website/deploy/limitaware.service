[Unit]
Description=LimitAware demo (gunicorn)
After=network.target

[Service]
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<DEPLOY_DIR>/website
Environment="PATH=<DEPLOY_DIR>/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=<DEPLOY_DIR>/venv/bin/gunicorn -w 1 -b 127.0.0.1:8010 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
